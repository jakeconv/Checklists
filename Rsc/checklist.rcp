/* checklist.rcp - PilRC resources for Jakesoft Checklists */

#include "checklist_res.h"

VERSION ID 1 "1.0"
APPLICATIONICONNAME ID 1000 "Checklists"

/* ---- App icons (generated by make_assets.py) ---- */
ICONFAMILY "icon_1bpp.bmp" "icon_2bpp.bmp" "icon_4bpp.bmp" "icon_8bpp.bmp"
SMALLICONFAMILY "small_1bpp.bmp" "small_2bpp.bmp" "small_4bpp.bmp" "small_8bpp.bmp"

/* ---- Jakesoft logo for the About box (120x45) ---- */
BITMAPFAMILY ID bmpLogo "logo_1bpp.bmp" "logo_2bpp.bmp" "logo_4bpp.bmp" "logo_8bpp.bmp"

/* ---- Main form: tabs for Lists / Templates ---- */
FORM ID frmMain AT (0 0 160 160)
USABLE
MENUID mnuBarMain
BEGIN
    TITLE "Checklists"
    PUSHBUTTON "Lists" ID btnLists AT (2 17 50 12) GROUP 1
    PUSHBUTTON "Templates" ID btnTemplates AT (54 17 60 12) GROUP 1
    LIST "" ID lstMain AT (0 32 146 99) VISIBLEITEMS 9
    SCROLLBAR ID sclMain AT (150 32 7 99) VALUE 0 MIN 0 MAX 0 PAGESIZE 8
    BUTTON "New..." ID btnNew AT (2 145 44 12)
END

/* ---- Checklist in progress: tap a row to check it off ---- */
FORM ID frmChecklist AT (0 0 160 160)
USABLE
MENUID mnuBarCheck
BEGIN
    TITLE "Checklist"
    LIST "" ID lstCheck AT (0 16 146 121) VISIBLEITEMS 11
    SCROLLBAR ID sclCheck AT (150 16 7 121) VALUE 0 MIN 0 MAX 0 PAGESIZE 10
    BUTTON "Done" ID btnCkDone AT (2 145 32 12)
    BUTTON "Add" ID btnCkAdd AT (38 145 28 12)
    BUTTON "Edit" ID btnCkEdit AT (70 145 28 12)
END

/* ---- Item editor (templates, and lists in progress) ---- */
FORM ID frmEdit AT (0 0 160 160)
USABLE
MENUID mnuBarEdit
BEGIN
    TITLE "Edit"
    LIST "" ID lstEdit AT (0 16 146 121) VISIBLEITEMS 11
    SCROLLBAR ID sclEdit AT (150 16 7 121) VALUE 0 MIN 0 MAX 0 PAGESIZE 10
    BUTTON "Done" ID btnEdDone AT (2 145 32 12)
    BUTTON "Add" ID btnEdAdd AT (36 145 28 12)
    BUTTON "Edit" ID btnEdEdit AT (66 145 28 12)
    BUTTON "Del" ID btnEdDel AT (96 145 24 12)
    BUTTON "Up" ID btnEdUp AT (122 145 18 12)
    BUTTON "Dn" ID btnEdDown AT (142 145 16 12)
END

/* ---- Text entry (names and items) ---- */
FORM ID frmText AT (2 56 156 102)
MODAL
DEFAULTBTNID btnTextCancel
BEGIN
    TITLE "Enter text"
    FIELD ID fldText AT (8 24 140 24) EDITABLE UNDERLINED SINGLELINE MAXCHARS 39
    BUTTON "OK" ID btnTextOK AT (8 86 36 12)
    BUTTON "Cancel" ID btnTextCancel AT (50 86 44 12)
    BUTTON "More" ID btnTextNext AT (100 86 44 12)
END

/* ---- Template picker ---- */
FORM ID frmPick AT (10 50 140 106)
MODAL
DEFAULTBTNID btnPickCancel
BEGIN
    TITLE "Start from template"
    LIST "" ID lstPick AT (6 17 118 66) VISIBLEITEMS 6
    SCROLLBAR ID sclPick AT (128 17 7 66) VALUE 0 MIN 0 MAX 0 PAGESIZE 5
    BUTTON "Start" ID btnPickStart AT (6 90 40 12)
    BUTTON "Cancel" ID btnPickCancel AT (52 90 44 12)
END

/* ---- About ---- */
FORM ID frmAbout AT (2 2 156 156)
MODAL
DEFAULTBTNID btnAboutOK
BEGIN
    TITLE "About Checklists"
    FORMBITMAP AT (18 18) BITMAP bmpLogo
    LABEL "Checklists 1.0" ID lblAboutName AT (CENTER 68) FONT 1
    LABEL "Reusable templates and lists." ID lblAboutL1 AT (CENTER 84)
    LABEL "Menu > Beam sends the open list." ID lblAboutL2 AT (CENTER 96)
    LABEL "(c) 2026 Jakesoft" ID lblAboutBy AT (CENTER 116)
    BUTTON "OK" ID btnAboutOK AT (CENTER 136 40 12)
END

/* ---- Menus ---- */
MENU ID mnuBarMain
BEGIN
    PULLDOWN "Lists"
    BEGIN
        MENUITEM "New List..." ID mnuNewList "N"
        MENUITEM "New Template..." ID mnuNewTemplate "T"
    END
    PULLDOWN "Options"
    BEGIN
        MENUITEM "About Checklists" ID mnuAbout
    END
END

MENU ID mnuBarCheck
BEGIN
    PULLDOWN "List"
    BEGIN
        MENUITEM "Uncheck All" ID mnuUncheckAll "U"
        MENUITEM "Edit Items" ID mnuEditItems "E"
        MENUITEM "Add Item" ID mnuAddItem "A"
        MENUITEM "Rename..." ID mnuRename "R"
        MENUITEM "Beam" ID mnuBeam "B"
        MENUITEM "Delete List" ID mnuDelete "D"
    END
    PULLDOWN "Options"
    BEGIN
        MENUITEM "About Checklists" ID mnuAbout
    END
END

MENU ID mnuBarEdit
BEGIN
    PULLDOWN "List"
    BEGIN
        MENUITEM "Add Item" ID mnuAddItem "A"
        MENUITEM "Rename..." ID mnuRename "R"
        MENUITEM "Beam" ID mnuBeam "B"
        MENUITEM "Delete" ID mnuDelete "D"
    END
    PULLDOWN "Options"
    BEGIN
        MENUITEM "About Checklists" ID mnuAbout
    END
END

/* ---- Alerts ---- */
ALERT ID alertDelete
CONFIRMATION
BEGIN
    TITLE "Delete?"
    MESSAGE "Delete \"^1\"? This cannot be undone."
    BUTTONS "Delete" "Cancel"
END

ALERT ID alertNoTemplates
INFORMATION
BEGIN
    TITLE "No templates yet"
    MESSAGE "Make a template first: tap Templates, then New, and add the items you want to reuse."
    BUTTONS "OK"
END

ALERT ID alertListFull
INFORMATION
BEGIN
    TITLE "List full"
    MESSAGE "A list can hold up to 100 items."
    BUTTONS "OK"
END

ALERT ID alertNoBeam
INFORMATION
BEGIN
    TITLE "Can't beam"
    MESSAGE "Beaming needs Palm OS 3.0 or later."
    BUTTONS "OK"
END

ALERT ID alertBeamFail
ERROR
BEGIN
    TITLE "Beam failed"
    MESSAGE "The list could not be beamed. Line up the infrared ports and try again."
    BUTTONS "OK"
END

ALERT ID alertSaveFail
ERROR
BEGIN
    TITLE "Not saved"
    MESSAGE "The change could not be saved. The device may be low on memory."
    BUTTONS "OK"
END

ALERT ID alertNoSelection
INFORMATION
BEGIN
    TITLE "Pick an item"
    MESSAGE "Tap an item in the list first."
    BUTTONS "OK"
END
